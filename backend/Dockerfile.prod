FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

WORKDIR /build

# 兼容传统及Deb822源配置，使用中科大HTTPS源下载构建依赖。
RUN set -eu; \
    for source_file in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
        if [ -f "$source_file" ]; then \
            sed -i -e 's|https\?://deb\.debian\.org|https://mirrors.ustc.edu.cn|g' \
                -e 's|https\?://security\.debian\.org|https://mirrors.ustc.edu.cn|g' "$source_file"; \
        fi; \
    done \
    && apt-get update -o Acquire::Retries=5 \
    && apt-get install -y --fix-missing --no-install-recommends build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --upgrade pip \
    && pip install --prefix=/install -r requirements.txt

FROM python:3.12-slim AS runtime

ARG BUILD_TIMESTAMP="unknown"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATA_DIRECTORY=/app/data \
    BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

WORKDIR /app

# 运行阶段同步切换，避免构建阶段成功后再次访问被拒的旧源。
RUN set -eu; \
    for source_file in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
        if [ -f "$source_file" ]; then \
            sed -i -e 's|https\?://deb\.debian\.org|https://mirrors.ustc.edu.cn|g' \
                -e 's|https\?://security\.debian\.org|https://mirrors.ustc.edu.cn|g' "$source_file"; \
        fi; \
    done \
    && apt-get update -o Acquire::Retries=5 \
    && apt-get install -y --fix-missing --no-install-recommends libpq5 postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local
COPY backend /app/backend
# 业务配置和运行数据统一通过 /app/data 的服务器绑定挂载提供。

EXPOSE 8000
VOLUME ["/app/data"]

CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-2}"]
